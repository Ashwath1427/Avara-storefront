# AVARA storefront environment variables (Render → Service → Environment).
# Placeholder NAMES only. Never commit real values; never put them in the app.

# --- Required -----------------------------------------------------------------
# Private Supabase Postgres connection string (Database → Connect). Server only.
AVARA_STORE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Owner key for /owner sign-in. At least 24 random characters.
AVARA_STORE_ADMIN_KEY=replace-with-a-long-random-owner-key
# Ed25519 PRIVATE key that signs activation tickets (base64url 32-byte seed or PEM).
# Generate with: python packaging/generate_ticket_keys.py
AVARA_TICKET_SIGNING_KEY=replace-with-generated-private-key

# --- Recommended ----------------------------------------------------------------
# Extra secret mixed into stored code hashes (any long random string). Set it
# once before the first code is created and never change it afterwards.
AVARA_CODE_PEPPER=replace-with-a-long-random-string
# Days a signed ticket keeps AVARA working offline (capped by plan expiry). Default 7.
AVARA_TICKET_OFFLINE_DAYS=7
# Public universal downloads: true only after both installers are uploaded.
AVARA_PUBLIC_DOWNLOADS=false
AVARA_STORE_PUBLIC_URL=https://avara-storefront.onrender.com

# --- Release storage (Supabase Storage, server only) -----------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-sb_secret-key
AVARA_RELEASE_BUCKET=avara-releases
# Old per-plan website orders (kept working until you remove them).
AVARA_INSTALLER_DOWNLOADS=true

# --- Email for old website orders ------------------------------------------------
RESEND_API_KEY=replace-with-resend-key
AVARA_STORE_EMAIL_FROM=AVARA Orders <orders@your-verified-domain>

# --- Local development only (never on Render) ------------------------------------
# AVARA_STORE_SECURE_COOKIE=0
# AVARA_STORE_TEST_MODE=1
